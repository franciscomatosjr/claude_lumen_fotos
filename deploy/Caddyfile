# SITE_ADDRESS is a domain in production (Caddy then gets a Let's Encrypt certificate on its own),
# or https://localhost:8443 to try the production setup locally with Caddy's own certificate.
{$SITE_ADDRESS}

encode zstd gzip

header {
	X-Content-Type-Options nosniff
	Referrer-Policy strict-origin-when-cross-origin
	X-Frame-Options DENY
	Permissions-Policy "camera=(), microphone=(), geolocation=()"
	-Server
}

handle /api/* {
	reverse_proxy api:8787
}

handle {
	root * /srv
	# Hashed build files never change; index.html must always be revalidated.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@html path / /index.html
	header @html Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}
