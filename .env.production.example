# Copy to .env.production and fill in. Never commit .env.production.
# Generate secrets with: openssl rand -hex 24

# Public address of the app. In production: the domain (DNS pointing at the server), e.g. fotos.example.com
SITE_ADDRESS=https://localhost:8443
APP_ORIGIN=https://localhost:8443
HTTP_PORT=8080
HTTPS_PORT=8443

POSTGRES_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
